# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Synthia_DB
DB_USER=postgres
DB_PASSWORD=a_tua_password

# ============================================
# CONFIGURAÇÃO DO SERVIDOR
# ============================================
PORT=3001

# ============================================
# SEGURANÇA (JWT)
# ============================================
# Usa um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=muda_isto_para_um_valor_aleatorio

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development

# ============================================
# RECUPERAÇÃO DE SENHA (Nodemailer / Gmail)
# ============================================
# Usa um Gmail + "App Password" (não a senha normal)
# Como criar: myaccount.google.com > Segurança > Senhas de app
EMAIL_USER=o_teu_email@gmail.com
EMAIL_PASS=
FRONTEND_URL=http://localhost:5173

# ============================================
# LOGIN COM GOOGLE (Google OAuth 2.0)
# ============================================
# Obtém em: console.cloud.google.com > Credenciais > ID do cliente OAuth 2.0
# Tipo: Aplicação Web | Origens autorizadas: http://localhost:5173
GOOGLE_CLIENT_ID=
